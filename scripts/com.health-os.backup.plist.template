<?xml version="1.0" encoding="UTF-8"?>
<!-- Daily backup at 13:00. Install:
     sed "s|__PROJECT_ROOT__|$PWD|g" scripts/com.health-os.backup.plist.template \
       > ~/Library/LaunchAgents/com.health-os.backup.plist
     launchctl load ~/Library/LaunchAgents/com.health-os.backup.plist
     (run the sed from the health-os checkout root so $PWD is the project root) -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.health-os.backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_ROOT__/scripts/backup.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>13</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__PROJECT_ROOT__/data/backup.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_ROOT__/data/backup.launchd.log</string>
</dict>
</plist>
